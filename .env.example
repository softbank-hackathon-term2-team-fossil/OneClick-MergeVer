# GitHub App credentials from https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Prefer a local path during development so the PEM never enters .env files.
GITHUB_PRIVATE_KEY_PATH=
# Keep line breaks escaped when storing the key in one environment variable.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# At least 32 random characters. Used to sign short-lived, HTTP-only sessions.
SBSB_SESSION_SECRET=
# At least 32 random characters. Encrypts saved SSH credentials at rest.
SBSB_CREDENTIAL_ENCRYPTION_KEY=

# SBSB's own Postgres: projects, saved servers, and deployment history.
# `pnpm db:up` starts it on port 5434 with these credentials; `pnpm db:deploy` creates the tables.
DATABASE_URL="postgresql://sbsb:sbsb@localhost:5434/sbsb?schema=public"

# Which LLM writes Dockerfiles and analyzes failures: openai (default) or gemini
LLM_PROVIDER=openai

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Gemini API (Google AI Studio key, OpenAI-compatible chat endpoint)
GEMINI_API_KEY=
# Or keep the key out of env files and point to a file that only contains it
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-3.5-flash-lite

# SBSB-owned private Docker Hub repository.
# Create this repository once in Docker Hub and keep it private.
DOCKERHUB_NAMESPACE=
DOCKERHUB_REPOSITORY=sbsb-images
DOCKERHUB_USERNAME=
# Use a Docker Hub access token with read/write permission, never an account password.
DOCKERHUB_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Cloud deployment (AWS EC2 / Azure VM). Leave blank if you only deploy on-premises.
# Cloud VMs pull images straight from Docker Hub. The VM reads a READ-ONLY Docker Hub
# token from the cloud's secret store with its own identity, so the token never appears
# in a remote command. Issue a separate read-only token; do not reuse DOCKERHUB_ACCESS_TOKEN.
# ---------------------------------------------------------------------------
# Optional. Docker Hub user that owns the read-only token (defaults to DOCKERHUB_USERNAME).
DOCKERHUB_PULL_USERNAME=

# AWS: the site server uses the AWS CLI (IAM role, AWS_PROFILE, or AWS_* credentials).
SBSB_AWS_ACCOUNT_ID=
AWS_REGION=ap-northeast-2
# Instance profile for new EC2. Its role needs AmazonSSMManagedInstanceCore and
# ssm:GetParameter on the parameter below.
SBSB_EC2_INSTANCE_PROFILE=
SBSB_EC2_INSTANCE_TYPE=t3.small
# SecureString parameter holding the read-only Docker Hub token, in each deploy region:
#   aws ssm put-parameter --name /sbsb/dockerhub/token --type SecureString --value <token>
SBSB_AWS_DOCKERHUB_TOKEN_PARAMETER=/sbsb/dockerhub/token

# Azure: the site server uses the `az login` session.
SBSB_AZURE_SUBSCRIPTION_ID=
SBSB_AZURE_RESOURCE_GROUP=
SBSB_AZURE_VM_SIZE=Standard_B2ls_v2
# Key Vault (Azure RBAC authorization mode) holding the read-only Docker Hub token:
#   az keyvault secret set --vault-name <vault> --name sbsb-dockerhub-token --value <token>
# SBSB grants each VM's managed identity "Key Vault Secrets User" on this vault.
SBSB_AZURE_KEY_VAULT=
SBSB_AZURE_DOCKERHUB_SECRET=sbsb-dockerhub-token

# Google Cloud Run (leave GCP_PROJECT_ID empty to disable it).
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# Cloud Run cannot log in to Docker Hub, so private images are pulled through an Artifact Registry
# REMOTE repository whose upstream is Docker Hub. Create it in GCP_LOCATION and give it the
# read-only Docker Hub token (stored in Secret Manager) as its upstream credential.
GCP_PROXY_REPOSITORY=dockerhub-proxy
# Local path to a deployer service account key (roles: Cloud Run Admin, Service Account User,
# Artifact Registry Reader). Never commit the file.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_MAX_INSTANCES=2
# Set to false to keep new services private (default grants allUsers invoker)
GCP_PUBLIC_ACCESS=true
