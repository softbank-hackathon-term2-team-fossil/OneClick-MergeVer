// SBSB data model. Adapted from OneClick's schema: projects, saved servers, and deployment history.
// SBSB has no user accounts, so a project belongs to the GitHub App installation that can access
// the repository. The database URL is read from DATABASE_URL in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String   @id @default(cuid())
  installationId BigInt // GitHub App installation that owns this project
  repository     String // owner/name, lower-cased
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  server      Server?
  deployments Deployment[]
  databases   ProjectDatabase[]
  envVars     ProjectEnvVar[]

  @@unique([installationId, repository])
}

enum ServerAuthType {
  PASSWORD
  PRIVATE_KEY
}

// The on-premises server a project deploys to. One per project, as before.
// SSH credentials are stored only as AES-256-GCM ciphertext (see lib/deployment-store.ts).
model Server {
  id                  String         @id @default(cuid())
  projectId           String         @unique
  host                String
  sshPort             Int            @default(22)
  username            String
  hostPort            Int
  containerPort       Int
  authType            ServerAuthType
  encryptedCredential String
  iv                  String
  authTag             String
  updatedAt           DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

enum DeployTarget {
  ONPREM
  AWS
  AZURE
  CLOUD_RUN
}

enum DeployTrigger {
  MANUAL
  ROLLBACK
}

enum DeploymentStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Deployment {
  id                 String           @id @default(cuid())
  projectId          String
  number             Int // per-project sequence (#1, #2 ...)
  target             DeployTarget
  trigger            DeployTrigger    @default(MANUAL)
  sourceDeploymentId String? // for a rollback: the deployment being restored
  imageTag           String // commit SHA published by the build, or "latest"
  image              String // full image reference that was deployed
  destination        String? // host:port, EC2 instance id, or Azure VM name
  status             DeploymentStatus @default(RUNNING)
  failureReason      String?
  url                String?
  startedAt          DateTime         @default(now())
  finishedAt         DateTime?
  databases          String[]         @default([]) // on-premises: managed databases running with this deployment

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number])
  @@index([projectId, target, startedAt])
}

// A database SBSB runs next to the app on its on-premises server (detected at repository analysis).
// The row outlives detection changes (active=false) so the password always matches the existing volume.
model ProjectDatabase {
  id                String   @id @default(cuid())
  projectId         String
  kind              String // postgres | mysql | mongo | redis
  image             String // pinned image the data volume was created with
  active            Boolean  @default(true)
  encryptedPassword String // AES-256-GCM, empty plaintext for redis
  iv                String
  authTag           String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
}

// A variable the user sets for the app container (API keys, or their own DATABASE_URL).
model ProjectEnvVar {
  id             String   @id @default(cuid())
  projectId      String
  key            String
  encryptedValue String // AES-256-GCM
  iv             String
  authTag        String
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
}
